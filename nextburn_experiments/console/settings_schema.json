  {
   "id": "decline",
   "title": "Model decline rule (Step 4)",
   "file": "config/boundary_model.json",
   "affects": [
    "method"
   ],
   "frozen_input": true,
   "note": "This file is an input of the frozen FM2 predictions. Saving a change re-fits Steps 4 and 5 on the next run; the published FM2 predictions stay frozen and the integrity check will show that this input changed.",
   "fields": [
    {
     "path": "decline.support_max_distance",
     "label": "Support radius (distance units)",
     "type": "number",
     "min": 0.1,
     "max": 5,
     "step": 0.1,
     "help": "Answer only if a test lies within this distance."
    },
    {
     "path": "decline.ci90_max_width",
     "label": "Widest 90% interval allowed",
     "type": "number",
     "min": 0.05,
     "max": 1,
     "step": 0.05
    },
    {
     "path": "decline.conflict_radius",
     "label": "Conflict radius (distance units)",
     "type": "number",
     "min": 0,
     "max": 5,
     "step": 0.1,
     "help": "Decline if a test this close had the opposite outcome."
    },
    {
     "path": "decline.scales.o2_pts",
     "label": "Oxygen points per distance unit",
     "type": "number",
     "min": 0.5,
     "max": 10,
     "step": 0.5
    },
    {
     "path": "decline.scales.p_frac",
     "label": "Pressure change per distance unit (fraction)",
     "type": "number",
     "min": 0.05,
     "max": 1,
     "step": 0.05
    },
    {
     "path": "decline.scales.g",
     "label": "Gravity per distance unit (g)",
     "type": "number",
     "min": 0.01,
     "max": 0.5,
     "step": 0.01
    },
    {
     "path": "decline.scales.direction_mismatch",
     "label": "Penalty for opposite flame direction",
     "type": "number",
     "min": 0,
     "max": 5,
     "step": 0.5
    }
   ]
  },
